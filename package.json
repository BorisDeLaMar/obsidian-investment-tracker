{
  "name": "obsidian-investment-tracker",
  "version": "0.1.0",
  "description": "Obsidian plugin: unified broker report import (T-Bank CSV, SberInvestments HTML), portfolio dashboard and MOEX ISS integration.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian-plugin",
    "investments",
    "fintech",
    "moex",
    "portfolio-tracker"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "chart.js": "^4.4.2",
    "xlsx": "^0.18.5"
  }
}
